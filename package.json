{
  "name": "pi-gemini-acp-provider",
  "version": "0.1.0",
  "description": "First-class Google Antigravity ACP provider for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "gemini",
    "antigravity",
    "agy",
    "acp",
    "agent-client-protocol",
    "provider"
  ],
  "files": [
    "extensions",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real-acp": "PI_GEMINI_ACP_REAL=1 vitest run test/real-cli.test.ts",
    "test:real-cli": "npm run test:real-acp",
    "test:live": "PI_GEMINI_ACP_LIVE=1 vitest run test/live-authenticated.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "test:packed": "node scripts/packed-install-smoke.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.0 <1",
    "@earendil-works/pi-coding-agent": ">=0.85.0 <1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.16.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "1.3.7",
    "unzipper": "0.12.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@types/node": "24.10.1",
    "@types/unzipper": "0.10.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
